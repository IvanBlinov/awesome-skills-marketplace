{
  "name": "awesome-skills-marketplace-site",
  "private": true,
  "type": "module",
  "scripts": {
    "index": "tsx indexer/cli.ts",
    "index:check": "tsx indexer/cli.ts --check",
    "dev": "npm run index && vite",
    "build": "npm run index && tsc -p . && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p .",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "release:check": "tsx indexer/bump-check-cli.ts"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.6",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "gray-matter": "^4.0.3",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
